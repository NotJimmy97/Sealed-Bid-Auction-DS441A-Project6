# Ganache RPC (mặc định khi chạy `npm run node`)
GANACHE_RPC_URL=http://127.0.0.1:8545

# Tùy chọn: private keys (phân tách bằng dấu phẩy). Bỏ trống -> dùng unlocked accounts của Ganache.
PRIVATE_KEYS=

# Tham số deploy (giây / ether)
BIDDING_DURATION=300
REVEAL_DURATION=300
MIN_INCREMENT=0.01
# Bỏ trống -> beneficiary = deployer (Auctioneer)
BENEFICIARY=

# Gas report: `npm run gas`; đặt file để xuất báo cáo dạng text
GAS_REPORT_FILE=
